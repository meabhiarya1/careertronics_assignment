# Base URL the browser uses for API calls.
# Defaults to "/api/v1", which the Vite dev server proxies to the backend.
# Set to an absolute URL (e.g. https://api.example.com/api/v1) for production builds.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev-server proxy forwards /api requests (dev only, not exposed to the browser).
API_PROXY_TARGET=http://localhost:4000
